# ==========================================
# Freelancer Financial Management Platform
# Environment Configuration Template
# ==========================================

# Server & API
PROJECT_NAME="Freelancer Financial Management Platform"
API_V1_STR="/api/v1"

# Database Configuration
# For local SQLite: sqlite:///./freelance_finance.db
# For Supabase / PostgreSQL: postgresql+psycopg2://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL="sqlite:///./freelance_finance.db"

# Supabase Auth & JWT Settings
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-for-hs256"

# Development Mode (Enables offline / dev token authentication)
DEV_AUTH_ENABLED=False

# Financial Engine Settings
DEFAULT_CURRENCY="USD"
